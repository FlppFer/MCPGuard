                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",        "value": "application/json" },
              { "key": "X-GitHub-Event",       "value": "pull_request" },
              { "key": "X-Hub-Signature-256",  "value": "computed-in-prerequest" }
            ],
            "body": { "mode": "raw", "raw": "{\"action\":\"closed\"}" },
            "url": { "raw": "{{base_url}}/v1/webhook/github", "host": ["{{base_url}}"], "path": ["v1", "webhook", "github"] }
          }
        }
