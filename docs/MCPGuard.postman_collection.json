                  "pm.test('error = not_found', () => pm.expect(pm.response.json().error).to.eql('not_found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-Key",   "value": "{{api_key}}" },
