                  "  repository: { clone_url: pm.collectionVariables.get('repo_url'), full_name: 'FlppFer/vulnerable_mcp_server' }",
                  "});",
                  "pm.request.body.raw = body;",
                  "const secret = pm.collectionVariables.get('webhook_secret');",
                  "const sig = CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'X-Hub-Signature-256', value: 'sha256=' + sig });"
                ]
              }
            },
            {
              "listen": "test",
