# MCPGuard Environment Variables
# Copy this file to .env and fill in the values.
#
# SCOPE controls which config file is loaded from config/:
#   local  -> config/default.yaml  (mock DB, localstack, agentic mock, no PR comments)
#   docker -> config/docker.yaml   (mock DB, localstack, real agentic, PR comments enabled)
#   prod   -> config/prod.yaml     (SQLite/S3, real agentic, PR comments enabled)

# ---------------------------------------------------------------------------
# ALL ENVIRONMENTS (required)
# ---------------------------------------------------------------------------

# Config profile (see above)
SCOPE=local

# GitHub webhook HMAC-SHA256 secret — must match the secret set in GitHub repo settings
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# API key pairs for direct API access (format: client_id:api_key,client_id2:api_key2)
MCPGUARD_API_KEYS=client1:apikey1

# ---------------------------------------------------------------------------
# DOCKER environment (SCOPE=docker) — set in .env, passed through docker-compose
# ---------------------------------------------------------------------------

# Both vars can use the SAME GitHub PAT — just set the same value for both.
#
# GITHUB_TOKEN  — used to post PR comments via the GitHub API
#                 Required permission: Pull requests (read & write)
# GIT_AUTH_TOKEN — used to authenticate git clone for private repos
#                 Required permission: Contents (read)
#                 Optional — only needed for private repositories
#
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
# GIT_AUTH_TOKEN=github_pat_xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# PROD environment (SCOPE=prod)
# ---------------------------------------------------------------------------

# AWS credentials for S3 artifact storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# GitHub PAT — same vars as docker section above, required in prod
