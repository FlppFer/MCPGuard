          "instant": true
        },
        {
          "expr": "histogram_quantile(0.99, sum(increase(mcpguard_analysis_duration_seconds_bucket[$__range])) by (le))",
          "legendFormat": "p99",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] }
